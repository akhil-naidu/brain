# Model (Command Code — not Vercel AI Gateway)
COMMAND_CODE_API_KEY=

# --- Slack MCP (https://mcp.slack.com/mcp) ---
# Create a Slack app with user scopes + bot_user, enable PKCE + MCP, then set:
# SLACK_MCP_CLIENT_ID=
# SLACK_MCP_CLIENT_SECRET=
# On first auth, add the exact redirect URI printed in .eve/slack-authorize-url.txt to the Slack app.

# --- Asana MCP (https://mcp.asana.com/v2/mcp) ---
# Create an Asana "MCP app" in the developer console, then set:
# ASANA_MCP_CLIENT_ID=
# ASANA_MCP_CLIENT_SECRET=
# Add the exact redirect URI from .eve/asana-authorize-url.txt to the app OAuth settings.

# --- Gmail MCP (https://gmailmcp.googleapis.com/mcp/v1) ---
# Create a Google Cloud OAuth client (Desktop or Web), enable Gmail API / Gmail MCP, then set:
# GOOGLE_MCP_CLIENT_ID=
# GOOGLE_MCP_CLIENT_SECRET=
# Add the exact redirect URI from .eve/gmail-authorize-url.txt to authorized redirect URIs.

# ClickUp MCP uses dynamic client registration — no client id/secret env vars required.
