# Model (Command Code — not Vercel AI Gateway)
COMMAND_CODE_API_KEY=

# Public site origin for OAuth redirect_uri (Menu Connect). Required behind
# reverse proxies when Origin/forwarded headers are unavailable or wrong.
# Example: https://brain.example.com
# BRAIN_PUBLIC_URL=

# Local SQLite chat history (default: .eve/brain-chats.sqlite)
# BRAIN_CHATS_DB_PATH=

# Next origin used by the eve minute schedule to trigger morning briefs.
# Default: http://127.0.0.1:3000 (eve's PORT is the Nitro port, not Next).
# BRAIN_INTERNAL_URL=http://127.0.0.1:3000

# Optional direct eve HTTP host for server-side brief runs (default: Next in
# dev, http://127.0.0.1:4274 in production).
# EVE_BASE_URL=
# BRAIN_EVE_URL=

# --- Slack MCP (https://mcp.slack.com/mcp) ---
# Prefer Configure in the chat connections menu (stored under .eve/).
# Or set env vars instead / as deploy-time fallback:
# SLACK_MCP_CLIENT_ID=
# SLACK_MCP_CLIENT_SECRET=
# Register redirect URIs (use your Brain origin; localhost only for local dev):
# - Menu Connect: {BRAIN_PUBLIC_URL or browser origin}/api/connections/slack/callback
# - Mid-turn auth: the exact URI printed in .eve/slack-authorize-url.txt

# --- Asana MCP (https://mcp.asana.com/v2/mcp) ---
# Prefer Configure in the chat connections menu (stored under .eve/).
# Or set env vars instead / as deploy-time fallback:
# ASANA_MCP_CLIENT_ID=
# ASANA_MCP_CLIENT_SECRET=
# Register redirect URIs:
# - Menu Connect: {origin}/api/connections/asana/callback
# - Mid-turn auth: the exact URI from .eve/asana-authorize-url.txt

# --- Gmail MCP (https://gmailmcp.googleapis.com/mcp/v1) ---
# Prefer Configure in the chat connections menu (stored under .eve/).
# Or set env vars instead / as deploy-time fallback:
# GOOGLE_MCP_CLIENT_ID=
# GOOGLE_MCP_CLIENT_SECRET=
# Register redirect URIs:
# - Menu Connect: {origin}/api/connections/gmail/callback
# - Mid-turn auth: the exact URI from .eve/gmail-authorize-url.txt

# ClickUp MCP uses dynamic client registration — no client id/secret env vars required.
# Menu Connect callback: {origin}/api/connections/clickup/callback

# --- dFlow Cloud MCP (https://app.dflow.sh/api/mcp) ---
# Uses OAuth + dynamic client registration — no client id/secret env vars required.
# Menu Connect callback: {origin}/api/connections/dflow/callback
# Sign in picks one organisation; read tools list apps/envs/services/logs/templates.

# --- GitHub remote MCP (https://api.githubcopilot.com/mcp/) ---
# Prefer Configure in the chat connections menu (stored under .eve/).
# Or set env vars instead / as deploy-time fallback:
# GITHUB_MCP_CLIENT_ID=
# GITHUB_MCP_CLIENT_SECRET=
# Create a GitHub OAuth App (https://github.com/settings/developers):
# - Homepage URL: your Brain origin
# - Authorization callback URL: {origin}/api/connections/github/callback
# Mid-turn auth also prints the exact redirect URI in .eve/github-authorize-url.txt

# --- Snowflake-managed MCP (Cortex Agents / Analyst / Search) ---
# Same auth model as Cursor's Snowflake plugin: MCP URL + Programmatic Access Token.
# Docs: https://docs.snowflake.com/en/user-guide/snowflake-cortex/cortex-agents-mcp
# Prefer Set up in the chat connections menu (stored under .eve/).
# 1. CREATE MCP SERVER … in a Snowflake worksheet.
# 2. Create a PAT: Snowsight → Settings → Authentication → Programmatic Access Tokens
#    (least-privileged role with USAGE on the MCP server).
# Or set env vars instead / as deploy-time fallback:
# SNOWFLAKE_MCP_URL=https://<account_url>/api/v2/databases/<db>/schemas/<schema>/mcp-servers/<name>
# SNOWFLAKE_PAT_TOKEN=
# Use hyphens in the account hostname if underscores cause client issues.
# Set up writes agent/lib/snowflake-mcp-url.ts so eve recompiles the connection URL
# (a stale baked URL like /api/v2/cortex/mcp causes MCP 404s). Restart if needed.

# --- Zernio hosted MCP (https://mcp.zernio.com/mcp) ---
# Social / messaging / ads API for AI agents. Docs: https://docs.zernio.com/mcp
# Uses OAuth 2.1 + PKCE + dynamic client registration — no client id/secret env vars.
# Menu Connect callback: {origin}/api/connections/zernio/callback
# Connect social accounts in the Zernio dashboard before posting.
