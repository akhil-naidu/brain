# Model (Command Code — not Vercel AI Gateway)
COMMAND_CODE_API_KEY=

# Better Auth session secret (required for sign-in). Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional dedicated secret for signing/verifying BRAIN1 license keys.
# Falls back to BETTER_AUTH_SECRET when unset.
# BRAIN_LICENSE_SECRET=

# Public site origin for Better Auth cookies + OAuth redirect_uri (Menu Connect),
# and for SEO absolute URLs (canonical, Open Graph, sitemap, robots.txt host).
# Required behind reverse proxies when Origin/forwarded headers are wrong.
# Example: https://brain.example.com
# BETTER_AUTH_URL=
# BRAIN_PUBLIC_URL=

# Optional SMTP for workspace invite emails (nodemailer). When unset, invites
# still work — admins copy the link. Prefer BRAIN_SMTP_URL, or host fields.
# BRAIN_EMAIL_FROM=Brain <brain@example.com>
# BRAIN_SMTP_URL=smtp://user:pass@smtp.example.com:587
# BRAIN_SMTP_HOST=smtp.example.com
# BRAIN_SMTP_PORT=587
# BRAIN_SMTP_SECURE=false
# BRAIN_SMTP_USER=
# BRAIN_SMTP_PASS=

# Required on /setup when set (always required in production). Generate with:
#   openssl rand -base64 32
# Paste the same value into the Bootstrap token field on /setup.
BRAIN_BOOTSTRAP_TOKEN=

# Required Postgres connection URL (auth, workspaces, chats, playbooks, schedules).
# Prefer BRAIN_DATABASE_URL; DATABASE_URL is accepted as an alias.
# Local: docker compose up -d db
# BRAIN_DATABASE_URL=postgres://brain:brain@127.0.0.1:5432/brain
# DATABASE_URL=
#
# Vitest always uses BRAIN_TEST_DATABASE_URL when set, otherwise local brain_test
# (never your .env BRAIN_DATABASE_URL), so verify cannot wipe the operator account.
# BRAIN_TEST_DATABASE_URL=postgres://brain:brain@127.0.0.1:5432/brain_test

# Host operator for scheduled briefs/playbooks (defaults to first user).
# BRAIN_OPERATOR_USER_ID=

# Shared bearer token for server-side scheduled runs (required for schedules only).
# Used by: eve → Next due-sweep cron, and Next → eve scheduled turns.
# Generate with: openssl rand -base64 32
# BRAIN_INTERNAL_TOKEN=

# Next origin used by the eve minute schedule to trigger morning briefs.
# Default: http://127.0.0.1:3000 (eve's PORT is the Nitro port, not Next).
# Set only if Next is not on that origin.
# BRAIN_INTERNAL_URL=http://127.0.0.1:3000

# Optional direct eve HTTP host for server-side brief runs (default: Next in
# dev, http://127.0.0.1:4274 in production).
# EVE_BASE_URL=
# BRAIN_EVE_URL=

# --- Slack MCP (https://mcp.slack.com/mcp) ---
# Prefer Configure in the chat connections menu (stored under .eve/).
# Or set env vars instead / as deploy-time fallback:
# SLACK_MCP_CLIENT_ID=
# SLACK_MCP_CLIENT_SECRET=
# Register redirect URIs (use your Brain origin; localhost only for local dev):
# - Menu Connect: {BRAIN_PUBLIC_URL or browser origin}/api/connections/slack/callback
# - Mid-turn auth: the exact URI printed in .eve/slack-authorize-url.txt

# --- Slack inbound (Events API + HITL buttons; not Vercel Connect) ---
# Prefer Tools → Slack → Set up inbound (instance admin). Env is deploy-time fallback:
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# Optional mention allowlist (comma/whitespace channel ids). Empty/unset = every channel.
# Tools → Slack → Inbound settings is preferred; a saved empty list overrides this env.
# SLACK_INBOUND_CHANNEL_IDS=
# Event Subscriptions + Interactivity Request URL:
# {BRAIN_PUBLIC_URL}/eve/v1/slack

# --- Asana MCP (https://mcp.asana.com/v2/mcp) ---
# Prefer Configure in the chat connections menu (stored under .eve/).
# Or set env vars instead / as deploy-time fallback:
# ASANA_MCP_CLIENT_ID=
# ASANA_MCP_CLIENT_SECRET=
# Register redirect URIs:
# - Menu Connect: {origin}/api/connections/asana/callback
# - Mid-turn auth: the exact URI from .eve/asana-authorize-url.txt

# --- Gmail MCP (https://gmailmcp.googleapis.com/mcp/v1) ---
# Prefer Configure in the chat connections menu (stored under .eve/).
# Or set env vars instead / as deploy-time fallback:
# GOOGLE_MCP_CLIENT_ID=
# GOOGLE_MCP_CLIENT_SECRET=
# Register redirect URIs:
# - Menu Connect: {origin}/api/connections/gmail/callback
# - Mid-turn auth: the exact URI from .eve/gmail-authorize-url.txt

# ClickUp MCP uses dynamic client registration — no client id/secret env vars required.
# Menu Connect callback: {origin}/api/connections/clickup/callback

# --- Notion MCP (https://mcp.notion.com/mcp) ---
# Uses OAuth + dynamic client registration — no client id/secret env vars required.
# Menu Connect callback: {origin}/api/connections/notion/callback
# Docs: https://developers.notion.com/docs/mcp

# --- Linear MCP (https://mcp.linear.app/mcp) ---
# Uses OAuth + dynamic client registration — no client id/secret env vars required.
# Menu Connect callback: {origin}/api/connections/linear/callback
# Docs: https://linear.app/docs/mcp

# --- Atlassian Rovo MCP (https://mcp.atlassian.com/v1/mcp/authv2) ---
# Uses OAuth + dynamic client registration — no client id/secret env vars required.
# Menu Connect callback: {origin}/api/connections/atlassian/callback
# Docs: https://support.atlassian.com/atlassian-rovo-mcp-server/docs/getting-started-with-the-atlassian-remote-mcp-server/

# --- Zernio MCP (https://mcp.zernio.com/mcp) ---
# Uses OAuth + dynamic client registration — no client id/secret env vars required.
# Menu Connect callback: {origin}/api/connections/zernio/callback
# Docs: https://docs.zernio.com/mcp

# --- Sentry MCP (https://mcp.sentry.dev/mcp) ---
# Uses OAuth + dynamic client registration — no client id/secret env vars required.
# Menu Connect callback: {origin}/api/connections/sentry/callback
# Docs: https://mcp.sentry.dev/

# --- dFlow Cloud MCP (https://app.dflow.sh/api/mcp) ---
# Uses OAuth + dynamic client registration — no client id/secret env vars required.
# Menu Connect callback: {origin}/api/connections/dflow/callback
# Sign in picks one organisation; read tools list apps/envs/services/logs/templates.

# --- GitHub remote MCP (https://api.githubcopilot.com/mcp/) ---
# Prefer Configure in the chat connections menu (stored under .eve/).
# Or set env vars instead / as deploy-time fallback:
# GITHUB_MCP_CLIENT_ID=
# GITHUB_MCP_CLIENT_SECRET=
# Create a GitHub OAuth App (https://github.com/settings/developers):
# - Homepage URL: your Brain origin
# - Authorization callback URL: {origin}/api/connections/github/callback
# Mid-turn auth also prints the exact redirect URI in .eve/github-authorize-url.txt

# --- Snowflake-managed MCP (PAT auth, same as Cursor Snowflake plugin) ---
# Prefer Tools → Snowflake → Set up (workspace admin) for MCP URL + PAT.
# Optional host-wide env fallback (no restart needed when using UI credentials):
# SNOWFLAKE_MCP_SERVER_URL=https://<org>-<account>.snowflakecomputing.com/api/v2/databases/<db>/schemas/<schema>/mcp-servers/<name>
# SNOWFLAKE_PAT_TOKEN=
# Docs: https://docs.snowflake.com/en/user-guide/snowflake-cortex/cortex-agents-mcp
# Create a PAT in Snowsight: Settings → Authentication → Programmatic Access Tokens.
# No OAuth app client id/secret.

# --- MongoDB MCP (Streamable HTTP URL; Set up in Tools, or env fallback) ---
# Prefer Tools → MongoDB → Set up for the MCP server URL (+ optional bearer).
# Eve cannot spawn Cursor-style stdio MCP — the server must expose HTTP, e.g.:
#   MDB_MCP_CONNECTION_STRING='mongodb://…' npx -y mongodb-mcp-server@latest --transport http --readOnly
# Docs: https://www.mongodb.com/docs/mcp-server/configuration/standalone-service/
# MONGODB_MCP_URL=https://your-mongodb-mcp.example/mcp
# MONGODB_MCP_TOKEN=

# --- MCP Toolbox for Databases (Streamable HTTP URL; Set up in Tools, or env) ---
# Prefer Tools → MCP Toolbox → Set up. Quickstart:
# https://mcp-toolbox.dev/documentation/getting-started/mcp_quickstart/
# Client URL: https://mcp-toolbox.dev/documentation/connect-to/mcp-client/
# TOOLBOX_MCP_URL=https://your-toolbox.example/mcp
# TOOLBOX_MCP_TOKEN=
