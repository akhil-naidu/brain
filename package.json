{
  "name": "brain",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*"
  },
  "scripts": {
    "dev": "next dev",
    "build": "eve build && next build",
    "start": "node scripts/start-production.mjs",
    "start:next": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "dev:eve": "eve dev",
    "build:eve": "eve build",
    "start:eve": "eve start",
    "openspec": "openspec",
    "openspec:validate": "openspec validate --all --no-interactive",
    "openspec:list": "openspec list",
    "openspec:specs": "openspec list --specs",
    "preinstall": "node -e \"const ua=process.env.npm_config_user_agent||''; if(!ua.includes('pnpm')){console.error('Use pnpm to install dependencies (see packageManager in package.json).'); process.exit(1)}\""
  },
  "packageManager": "pnpm@11.13.1",
  "dependencies": {
    "@ai-sdk/openai": "^4.0.20",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "ai": "^7.0.34",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "eve": "^0.27.6",
    "lucide-react": "^1.27.0",
    "microsandbox": "^0.5.10",
    "next": "^16.2.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.7.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "24.x",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "happy-dom": "^20.11.1",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "24.x",
    "pnpm": ">=11"
  }
}
